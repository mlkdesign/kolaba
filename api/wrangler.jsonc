// kolaba-api — Cloudflare Worker. Secrets (never in git): wrangler secret put RESEND_API_KEY | MEDIA_URL_SECRET | ADMIN_INITIAL_PASSWORD
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kolaba-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "kolaba-db", "database_id": "880ac093-6e95-43b9-8c39-d42a8f539316", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kolaba-media" }],
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_WRITE", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://mlkdesign.github.io",
    "APP_URL": "https://mlkdesign.github.io/kolaba/",
    "API_URL": "https://kolaba-api.mlkdesignweb.workers.dev",
    "EMAIL_FROM": "kolaba. <onboarding@resend.dev>",
    "SIGNUPS_PER_DAY": "50",
    "MAX_PHOTO_MB": "10",
    "MAX_VIDEO_MB": "50",
    "MAX_VIDEO_SECONDS": "60",
    // Resend has no verified domain yet (github.io can't be verified): codes reach only this address.
    "SIGNUP_ALLOWED_EMAILS": "mlkdesignweb@gmail.com",
    // CLOSED TEST ONLY: every sign-up / sign-in code goes to this inbox (accounts get email_verification = 'test_inbox',
    // never 'owner'). Remove before a public launch so codes reach their owners again.
    "TEST_CODE_INBOX": "mlkdesignweb@gmail.com",
    // Accounts allowed to switch their own PRO on and off for testing (Settings). Nobody else can.
    "PRO_TEST_EMAILS": "mlkdesignweb@gmail.com",
    // Sign in with Google: the Web client id (public — the audience of the ID tokens; no client secret is used).
    "GOOGLE_CLIENT_ID": "888396863806-et1d0p9h08gaptueupl1c9lhg9dlivqa.apps.googleusercontent.com",
    // The iOS app's OAuth client (bundle com.kolaba.app): its Google ID tokens carry this audience.
    "GOOGLE_IOS_CLIENT_IDS": "888396863806-9k5qt9rgfc9pj1r5b8ahcbevc5faqsi7.apps.googleusercontent.com",
    // Admin panel (/v1/admin): the only administrator, and the only origin that may call the admin API. The first
    // password comes from the secret ADMIN_INITIAL_PASSWORD (wrangler secret put) and must be changed at first sign-in.
    "ADMIN_EMAILS": "milka19051995@gmail.com",
    "ADMIN_ORIGINS": "https://mlkdesign.github.io",
    // Paid plans stay off until StoreKit 2 is built: no PRO anywhere, every feature open to everyone.
    "MONETIZATION_ENABLED": "false",
    // Moderation / anti-spam limits (see docs/MODERATION.md).
    "NEW_CONVERSATIONS_PER_DAY": "25",
    "MESSAGES_BEFORE_REPLY": "5",
    "MAX_VOICE_KB": "3072",
    "MAX_VOICE_SECONDS": "300",
    "MAX_FEEDBACK_ATTACHMENT_MB": "5",
    "REVIEW_VIDEO_FRAMES": "6",
    "EVIDENCE_RETENTION_DAYS": "180"
  },
  // Daily retention job (src/lib/retention.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  "env": {
    "local": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "APP_URL": "http://localhost:5173/",
        "API_URL": "http://127.0.0.1:8787",
        "EMAIL_FROM": "kolaba. <onboarding@resend.dev>",
        "SIGNUPS_PER_DAY": "1000",
        "MAX_PHOTO_MB": "10",
        "MAX_VIDEO_MB": "50",
        "MAX_VIDEO_SECONDS": "60",
        "ADMIN_EMAILS": "milka19051995@gmail.com",
        "ADMIN_ORIGINS": "http://localhost:5174,http://127.0.0.1:5174",
        "GOOGLE_CLIENT_ID": "888396863806-et1d0p9h08gaptueupl1c9lhg9dlivqa.apps.googleusercontent.com",
        "MONETIZATION_ENABLED": "false",
        "NEW_CONVERSATIONS_PER_DAY": "25",
        "MESSAGES_BEFORE_REPLY": "5",
        "MAX_VOICE_KB": "3072",
        "MAX_VOICE_SECONDS": "300",
        "MAX_FEEDBACK_ATTACHMENT_MB": "5",
        "REVIEW_VIDEO_FRAMES": "6",
        "EVIDENCE_RETENTION_DAYS": "180"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "kolaba-db", "database_id": "880ac093-6e95-43b9-8c39-d42a8f539316", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kolaba-media" }]
    }
  }
}
